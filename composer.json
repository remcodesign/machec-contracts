{
    "name": "machec/contracts",
    "description": "Shared Composer package for cross-app value objects, casts, and services used by the Machec Laravel Cloud apps.",
    "license": "proprietary",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Machec\\Contracts\\": "src/"
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Machec\\Contracts\\MachecContractsServiceProvider"
            ]
        }
    }
}
